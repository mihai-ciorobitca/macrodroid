<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.codex.rootlessmacros">
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.instagram.android" />
        <package android:name="com.arlosoft.macrodroid" />
    </queries>
    <application android:label="Social Macro Controls" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".RootlessSetup" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MacroCommand" android:exported="true"
            android:noHistory="true" android:excludeFromRecents="true" />
        <service android:name=".RootlessControls" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/controls" />
        </service>
        <provider android:name=".RootlessExport" android:authorities="com.codex.rootlessmacros.export"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
