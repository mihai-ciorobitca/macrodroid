se \"$action\" in\n  status) printf '%s' \"$current\" ;;\n  can-follow)\n    echo YES\n    ;;\n  record)\n    case \"$handle\" in ''|*[!a-zA-Z0-9._]*) echo 'Error: invalid handle'; exit 1;; esac\n    if [ -f \"$file\" ] && grep -Fxq \"$handle\" \"$file\"; then\n      printf '%s' \"$current\"\n      exit 0\n    fi\n    printf '%s\\n' \"$handle\" >> \"$file\"\n    printf '%s' \"$(count)\"\n    ;;\nesac\n)\nplatform=${1:-}\nhandle=${2:-}\ncase \"$platform\" in tiktok|instagram) ;; *) echo 'Error: invalid platform'; exit 0;; esac\ncase \"$handle\" in ''|NONE|*[!a-zA-Z0-9._]*)\n  follow_count \"$platform\" status\n  exit 0;;\nesac\nbase=/sdcard/Download/macrodroid_social_follows\ntoday=$(date +%Y-%m-%d)\nsnapshot=\"$base/$platform-verify.xml\"\npending=\"$base/$platform-pending-$today.txt\"\nskipped=\"$base/$platform-skipped-$today.txt\"\nif ! uiautomator dump \"$snapshot\" >/dev/null 2>&1; then\n  printf '%s\\n' \"$handle\" >> \"$pending\"\n  echo 'Error: follow state unknown'\n  exit 0\nfi\nnodes=$(tr '>' '\\n' < \"$snapshot\")\nif [ \"$platform\" = tiktok ]; then\n  printf '%s\\n' \"$nodes\" | grep -Fq \"@$handle\" || { printf '%s\\n' \"$handle\" >> \"$pending\"; echo 'Error: wrong profile'; exit 0; }\n  followed=$(printf '%s\\n' \"$nodes\" | grep -E 'text=\"(Following|Friends)\" resource-id=\"com.zhiliaoapp.musically:id/fuj\"' || true)\n  still_follow=$(printf '%s\\n' \"$nodes\" | grep 'text=\"Follow\" resource-id=\"com.zhiliaoapp.musically:id/fuj\"' || true)\nelse\n  printf '%s\\n' \"$nodes\" | grep -q \"text=\\\"$handle\" || { printf '%s\\n' \"$handle\" >> \"$pending\"; echo 'Error: wrong profile'; exit 0; }\n  followed=$(printf '%s\\n' \"$nodes\" | grep 'text=\"Following\" resource-id=\"com.instagram.android:id/profile_header_follow_button\"' || true)\n  still_follow=$(printf '%s\\n' \"$nodes\" | grep 'text=\"Follow\" resource-id=\"com.instagram.android:id/profile_header_follow_button\"' || true)\nfi\nif [ -n \"$followed\" ]; then\n  follow_count \"$platform\" record \"$handle\"\nelif [ -n \"$still_follow\" ]; then\n  printf '%s\\n' \"$handle\" >> \"$skipped\"\n  follow_count \"$platform\" status\nelse\n  printf '%s\\n' \"$handle\" >> \"$pending\"\n  echo 'Error: follow state unknown'\nfi\nCODEX_FOLLOW_SCRIPT","m_variableToSaveResponse":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"followCountText","m_stringValue":"","m_type":2,"supportsInput":false,"supportsOutput":true},"timeoutSeconds":600,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-820762395819149803,"m_classType":"ShellScriptAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":-1137214089161247878,"m_classType":"EndIfAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"m_nonRoot":false,"m_script":"sh /sdcard/Download/tiktok_clock.sh status 'Returning to the TikTok feed...'","timeoutSeconds":10,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-546678994496961981,"m_classType":"ShellScriptAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"m_nonRoot":false,"m_script":"sh /sdcard/Download/social_follow_return.sh tiktok","m_variableToSaveResponse":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"followCountText","m_stringValue":"","m_type":2,"supportsInput":false,"supportsOutput":true},"timeoutSeconds":600,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-3887974787782787622,"m_classType":"ShellScriptAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"m_non