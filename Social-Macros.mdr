stem/bin/sh\nset -eu\n\nplatform=${1:-}\naction=${2:-status}\nhandle=${3:-}\ncase \"$platform\" in tiktok|instagram) ;; *) echo 'Error: invalid platform'; exit 1;; esac\ncase \"$action\" in status|can-follow|record) ;; *) echo 'Error: invalid action'; exit 1;; esac\n\ntoday=$(date +%Y-%m-%d)\nstore=/sdcard/Download/macrodroid_social_follows\nmkdir -p \"$store\"\nfile=\"$store/$platform-$today.txt\"\n\ncount() {\n  if [ -f \"$file\" ]; then\n    sed '/^$/d' \"$file\" | wc -l | tr -d ' '\n  else\n    echo 0\n  fi\n}\n\ncurrent=$(count)\ncase \"$action\" in\n  status) printf '%s' \"$current\" ;;\n  can-follow)\n    echo YES\n    ;;\n  record)\n    case \"$handle\" in ''|*[!a-zA-Z0-9._]*) echo 'Error: invalid handle'; exit 1;; esac\n    if [ -f \"$file\" ] && grep -Fxq \"$handle\" \"$file\"; then\n      printf '%s' \"$current\"\n      exit 0\n    fi\n    printf '%s\\n' \"$handle\" >> \"$file\"\n    printf '%s' \"$(count)\"\n    ;;\nesac\nCODEX_FOLLOW_SCRIPT","m_variableToSaveResponse":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"followCountText","m_stringValue":"","m_type":2,"supportsInput":false,"supportsOutput":true},"timeoutSeconds":600,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-4135915399428129718,"m_classType":"ShellScriptAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"booleanDictionaryKeys":{"keys":[]},"dictionaryKeys":[],"dictionaryOrArrayType":-1,"existingManualKeyType":0,"m_booleanInvert":false,"m_darkMode":-1,"m_doubleRandomMax":0.0,"m_doubleRandomMin":0.0,"m_falseLabel":"False","m_intExpression":false,"m_intRandom":true,"m_intRandomMax":10,"m_intRandomMin":5,"m_intValueDecrement":false,"m_intValueIncrement":false,"m_newBooleanValue":false,"m_newDoubleValue":0.0,"m_newIntValue":0,"m_trueLabel":"True","m_userPrompt":false,"m_userPromp