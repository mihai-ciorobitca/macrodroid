grep -Fxq \"$handle\" \"$file\"; then\n      printf '%s' \"$current\"\n      exit 0\n    fi\n    printf '%s\\n' \"$handle\" >> \"$file\"\n    printf '%s' \"$(count)\"\n    ;;\nesac\nCODEX_FOLLOW_SCRIPT","m_variableToSaveResponse":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"followCountText","m_stringValue":"","m_type":2,"supportsInput":false,"supportsOutput":true},"timeoutSeconds":600,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-2156066446015265655,"m_classType":"ShellScriptAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"m_nonRoot":false,"m_script":"TIKTOK_CLOCK_OWNER=igfeed sh /sdcard/Download/tiktok_clock.sh status '▶ Instagram watcher started — tap bubble again to stop.'","timeoutSeconds":10,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-8306821729499999751,"m_classType":"ShellScriptAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"m_nonRoot":false,"m_script":"TIKTOK_CLOCK_OWNER=igfeed sh /sdcard/Download/tiktok_clock.sh status 'Finding German accounts to follow...'","timeoutSeconds":10,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-8306821729499999750,"m_classType":"ShellScriptAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"m_nonRoot":false,"m_script":"sh -s -- instagram <<'CODEX_FOLLOW_SCRIPT'\n#!/system/bin/sh\nset -eu\nplatform=${1:-}\ncase \"$platform\" in tiktok|instagram) ;; *) echo NONE; exit 0;; esac\nbase=/sdcard/Download/macrodroid_social_follows\ntoday=$(date +%Y-%m-%d)\nmkdir -p \"$base\"\nrecorded=\"$base/$platform-$today.txt\"\nskipped=\"$base/$platform-skipped-$today.txt\"\npending=\"$base/$platform-pending-$today.txt\"\nlist=\"/sdcard/Download/social_follow_candidates_$platform.txt\"\nsnapshot=\"$base/$platform-profile.xml\"\n[ -f \"$list\" ] || { echo NONE; exit 0; }\n\nif [ \"$platform\" = tiktok ]; then\n  am start -a android.intent.action.VIEW -d tiktok://feed -p com.zhiliaoapp.musically </dev/null >/dev/null 2>&1 || true\nelse\n  am start -a android.intent.action.VIEW -d instagram://explore -p com.instagram.android </dev/null >/dev/null 2>&1 || true\nfi\nsleep 3\n\nattempts=0\nwhile IFS= read -r handle; do\n  handle=$(printf '%s' \"$handle\" | tr -d '\\r')\n  case \"$handle\" in ''|\\#*|*[!a-zA-Z0-9._]*) continue;; esac\n  used=0\n  for history in \"$base\"/\"$platform\"-20??-??-??.txt; do\n    [ -f \"$history\" ] || continue\n    if grep -Fxq \"$handle\" \"$history\"; then used=1; break; fi\n  done\n  [ \"$used\" -eq 0 ] || continue\n  [ ! -f \"$pending\" ] || ! grep -Fxq \"$handle\" \"$pending\" || continue\n  [ ! -f \"$skipped\" ] || ! grep -Fxq \"$handle\" \"$skipped\" || continue\n  attempts=$((attempts + 1))\n  [ \"$attempts\" -le 3 ] || { echo NONE; exit 0; }\n  if [ \"$platform\" = tiktok ]; then\n    am start -a android.intent.action.VIEW -d \"https://www.tiktok.com/@$handle\" -p com.zhiliaoapp.musically </dev/null >/dev/null 2>&1 || true\n    sleep 1\n    am start -a android.intent.action.VIEW -d \"https://www.tiktok.com/@$handle\" -p com.zhiliaoapp.musically </dev/null >/dev/null 2>&1 || true\n  else\n    am start -a android.intent.action.VIEW -d \"https://www.instagram.com/$handle/\" -p com.instagram.android </dev/null >/dev/null 2>&1 || true\n  fi\n  sleep 2\n  if ! uiautomator dump \"$snapshot\" </dev/null >/dev/null 2>&1; then\n    echo NONE\n    exit 0\n  fi\n  nodes=$(tr '>' '\\n' < \"$snapshot\")\n  if [ \"$platform\" = tiktok ]; then\n    printf '%s\\n' \"$nodes\" | grep -Fq \"@$handle\" || continue\n    printf '%s\\n' \"$nodes\" | grep -q 'text=\"Follow\" resource-id=\"com.zhiliaoapp.musically:id/fuj\"' || continue\n  else\n    printf '%s\\n' \"$nodes\" | grep -q \"text=\\\"$handle\" || continue\n    printf '%s\\n' \"$nodes\" | grep -q 'text=\"Follow\" resource-id=\"com.instagram.android:id/profile_header_follow_button\"' || continue\n  fi\n  printf '%s' \"$handle\"\n  exit 0\ndone < \"$list\"\necho NONE\nCODEX_FOLLOW_SCRIPT","m_variableToSaveResponse":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"followCandidate","m_stringValue":"","m_type":2,"supportsInput":false,"supportsOutput":true},"timeoutSeconds":600,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-1890317404979809386,"m_classType":"ShellScriptAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"childrenCollapsed":false,"dontLogIfConditionIsFalse":false,"disableLogging":false,"m_SIGUID":-3525594716102166830,"m_classType":"IfConditionAction","m_comment":"","m_constraintList":[{"checkCase":false,"dictionaryType":-1,"enableRegex":false,"m_booleanValue":false,"m_doubleValue":0.0,"m_intCompareVariable":false,"m_intGreaterThan":false,"m_intLessThan":false,"m_intNotEqual":false,"m_intValue":0,"m_stringComparisonType":0,"m_stringEqual":false,"m_stringValue":"NONE","m_variable":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"followCandidate","m_stringValue":"Read or add comments. Add 1st comments","m_type":2,"supportsInput":true,"supportsOutput":true},"disableLogging":false,"m_SIGUID":-855405111834172508,"m_classType":"MacroDroidVariableConstraint","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"checkCase":false,"dictionaryType":-1,"enableRegex":false,"m_booleanValue":false,"m_doubleValue":0.0,"m_intCompareVariable":false,"m_intGreaterThan":false,"m_intLessThan":false,"m_intNotEqu