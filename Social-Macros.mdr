n","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"m_nonRoot":false,"m_script":"sh -s -- tiktok status <<'CODEX_FOLLOW_SCRIPT'\n#!/system/bin/sh\nset -eu\n\nplatform=${1:-}\naction=${2:-status}\nhandle=${3:-}\ncase \"$platform\" in tiktok|instagram) ;; *) echo 'Error: invalid platform'; exit 1;; esac\ncase \"$action\" in status|can-follow|record) ;; *) echo 'Error: invalid action'; exit 1;; esac\n\ntoday=$(date +%Y-%m-%d)\nstore=/sdcard/Download/macrodroid_social_follows\nmkdir -p \"$store\"\nfile=\"$store/$platform-$today.txt\"\n\ncount() {\n  if [ -f \"$file\" ]; then\n    sed '/^$/d' \"$file\" | wc -l | tr -d ' '\n  else\n    echo 0\n  fi\n}\n\ncurrent=$(count)\ncase \"$action\" in\n  status) printf '%s' \"$current\" ;;\n  can-follow)\n    echo YES\n    ;;\n  record)\n    case \"$handle\" in ''|*[!a-zA-Z0-9._]*) echo 'Error: invalid handle'; exit 1;; esac\n    if [ -f \"$file\" ] && grep -Fxq \"$handle\" \"$file\"; then\n      printf '%s' \"$current\"\n      exit 0\n    fi\n    printf '%s\\n' \"$handle\" >> \"$file\"\n    printf '%s' \"$(count)\"\n    ;;\nesac\nCODEX_FOLLOW_SCRIPT","m_variableToSaveResponse":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"followCountText","m_stringValue":"","m_type":2,"supportsInput":false,"supportsOutput":true},"timeoutSeconds":600,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-3495350695187620227,"m_classType":"ShellScriptAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"m_classType":"FloatingButtonConfigureAction","m_SIGUID":-8351921204399999983,"m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"identifier":"Start/Stop TikTok","triggerGuid":-8313083775729039221,"macroGuid":-9034588575580119385,"macroName":"TikTok TESTING 100","isInitialised":true,"alpha":100,"enableOption":0,"iconBgColor":-9079435,"iconText":"","iconTextColor":-1,"iconType":0,"imagePackageName":"android","imageResourceId":17301539,"imageResourceName":"ic_media_pause","padding":20,"preventRemoveByDrag":true,"size":0,"transparentBackground":false,"updateLocation":false,"usePercentForLocation":true,"xLocation":7,"yLocation":23},{"blockNextAction":true,"m_nonRoot":false,"m_script":"sh /sdcard/Download/tiktok_clock.sh status '▶ TikTok watcher started — tap bubble again to stop.'","timeoutSeconds":10,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-8765902491704161696,"m_classType":"ShellScriptAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"m_nonRoot":false,"m_script":"sh /sdcard/Download/tiktok_clock.sh status 'Checking German accounts to follow...'","timeoutSeconds":10,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-934049529695466398,"m_classType":"ShellScriptAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"m_nonRoot":false,"m_script":"sh -s -- tiktok <<'CODEX_FOLLOW_SCRIPT'\n#!/system/bin/sh\nset -eu\nplatform=${1:-}\ncase \"$platform\" in tiktok|instagram) ;; *) echo NONE; exit 0;; esac\nbase=/sdcard/Download/macrodroid_social_follows\ntoday=$(date +%Y-%m-%d)\nmkdir -p \"$base\"\nrecorded=\"$base/$platform-$today.txt\"\nskipped=\"$base/$platform-skipped-$today.txt\"\npending=\"$base/$platform-pending-$today.txt\"\nlist=\"/sdcard/Download/social_follow_candidates_$platform.txt\"\nsnapshot=\"$base/$platform-profile.xml\"\n[ -f \"$list\" ] || { echo NONE; exit 0; }\n\nif [ \"$platform\" = tiktok ]; then\n  am start -a android.intent.action.VIEW -d tiktok://feed -p com.zhiliaoapp.musically </dev/null >/dev/null 2>&1 || true\nelse\n  am start -a android.intent.action.VIEW -d instagram://explore -p com.instagram.android </dev/null >/dev/null 2>&1 || true\nfi\nsleep 3\n\nattempts=0\nwhile IFS= read -r handle; do\n  handle=$(printf '%s' \"$handle\" | tr -d '\\r')\n  case \"$handle\" in ''|\\#*|*[!a-zA-Z0-9._]*) continue;; esac\n  used=0\n  for history in \"$base\"/\"$platform\"-20??-??-??.txt; do\n    [ -f \"$history\" ] || continue\n    if grep -Fxq \"$handle\" \"$history\"; then used=1; break; fi\n  done\n  [ \"$used\" -eq 0 ] || continue\n  [ ! -f \"$pending\" ] || ! grep -Fxq \"$handle\" \"$pending\" || continue\n  [ ! -f \"$skipped\" ] || ! grep -Fxq \"$handle\" \"$skipped\" || continue\n  attempts=$((attempts + 1))\n  [ \"$attempts\" -le 3 ] || { echo NONE; exit 0; }\n  if [ \"$platform\" = tiktok ]; then\n    am start -a android.intent.action.VIEW -d \"https://www.tiktok.com/@$handle\" -p com.zhiliaoapp.musically </dev/null >/dev/null 2>&1 || true\n    sleep 1\n    am start -a android.intent.action.VIEW -d \"https://www.tiktok.com/@$handle\" -p com.zhiliaoapp.musically </dev/null >/dev/null 2>&1 || true\n  else\n    am start -a android.intent.action.VIEW -d \"https://www.instagram.com/$handle/\" -p com.instagram.android </dev/null >/dev/null 2>&1 || true\n  fi\n  sleep 2\n  if ! uiautomator dump \"$snapshot\" </dev/null >/dev/null 2>&1; then\n    echo NONE\n    exit 0\n  fi\n  nodes=$(tr '>' '\\n' < \"$snapshot\")\n  if [ \"$platform\" = tiktok ]; then\n    printf '%s\\n' \"$nodes\" | grep -Fq \"@$handle\" || continue\n    printf '%s\\n' \"$nodes\" | grep -q 'text=\"Follow\" resource-id=\"com.zhiliaoapp.musically:id/fuj\"' || continue\n  else\n    printf '%s\\n' \"$nodes\" | grep -q \"text=\\\"$handle\" || continue\n    printf '%s\\n' \"$nodes\" | grep -q 'text=\"Follow\" resource-id=\"com.instagram.android:id/profile_header_follow_button\"' || continue\n  fi\n  printf '%s' \"$handle\"\n  exit 0\ndone < \"$list\"\necho NONE\nCODEX_FOLLOW_SCRIPT","m_variableToSaveResponse":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m